TELEGRAM_BOT_TOKEN=
# Claude auth — pick ONE of the following:
#   ANTHROPIC_API_KEY       — pay-as-you-go API credits (sk-ant-api...).
#   CLAUDE_CODE_OAUTH_TOKEN — long-lived token backed by a Claude Max/Pro
#                             subscription (sk-ant-oat...). Generate with
#                             `claude setup-token` from an authed machine.
# CLAUDE_CODE_OAUTH_TOKEN takes precedence when both are set.
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=
# Agent backend: "claude" (Claude Agent SDK, default) or "codex" (OpenAI
# Codex CLI). Codex reuses OPENAI_API_KEY and the same Composio MCP server.
AGENT_BACKEND=claude
# Model per backend — only the one matching AGENT_BACKEND is used.
ANTHROPIC_MODEL=claude-fable-5-1
CODEX_MODEL=gpt-5.6-sol
HISTORY_DB_PATH=/data/history.sqlite
MEMORY_PATH=/data/memory.md
ATTACHMENTS_DIR=/data/attachments
PERSONA_PATH=prompts/flat_hunt.md
MAX_AGENT_TURNS=40
# Stream Claude's intermediate text blocks to the main chat as they
# arrive. Set to false to show only the final reply (useful in noisy
# group chats).
STREAM_INTERMEDIATE_TEXT=true
# Voice notes (optional) — OpenAI Whisper for transcribing Telegram voice notes.
OPENAI_API_KEY=
# Composio triggers (optional — leave unset to disable the webhook server).
COMPOSIO_WEBHOOK_SECRET=
TRIGGER_CHAT_ID=
# Voice call dispatch (optional) — shared secret for POST /voice/dispatch,
# called by ElevenLabs Conversational AI via its webhook-tool config.
VOICE_DISPATCH_SECRET=
IRIS_VOICE_DISPATCH_URL=https://iris-familiar.fly.dev/voice/dispatch
# Voice shared-context (optional) — POST /voice/init is the ElevenLabs
# conversation-initiation webhook. It returns the live shared context
# (current memory + recent main-DM history, keyed off TRIGGER_CHAT_ID) so the
# phone agent starts each call with the same brain as the text agent. Auth is
# the `x-dispatch-secret` header; defaults to VOICE_DISPATCH_SECRET when
# VOICE_INIT_SECRET is unset. VOICE_PERSONA_PATH points at the phone persona.
VOICE_INIT_SECRET=
VOICE_PERSONA_PATH=prompts/iris_voice.md
IRIS_VOICE_INIT_URL=https://iris-familiar.fly.dev/voice/init
# ElevenLabs agent-as-code CLI (optional). The official CLI stores auth in
# ~/.agents/api_keys.json after `elevenlabs auth login`; ELEVENLABS_API_KEY is
# useful for CI and for non-interactive environments.
ELEVENLABS_API_KEY=
ELEVENLABS_IRIS_AGENT_ID=
# MCP proxy (optional) — if set, exposes /mcp as a transparent Streamable
# HTTP proxy that forwards to this upstream URL, forcing the compliant
# `Accept: application/json, text/event-stream` header. Use when an MCP
# client (e.g. ElevenLabs) sends a non-compliant Accept header and the
# upstream server rejects with 406.
MCP_PROXY_UPSTREAM=
PORT=8080
# Max Telegram messages processed concurrently (parallel agent runs). Each
# run spawns its own model subprocess, so keep this in line with available
# RAM. Default 4. Turns within one session are always serialized; this caps
# how many *different* sessions run at once.
MAX_CONCURRENT_UPDATES=4
# Forum-topic workspaces (optional). Comma-separated chat IDs of groups
# where the bot answers every message (no @-mention needed) and treats each
# forum topic as a parallel, isolated session. The bot must be an admin with
# "Manage topics" so it can create/close topics itself.
WORKSPACE_CHAT_IDS=
# The main DM chat ID. Forum-topic sessions in a workspace group are seeded
# with this DM's history as shared background on top of their own thread.
MAIN_DM_CHAT_ID=
# Periodic self-nudge (optional — leave unset to disable). Uses
# TRIGGER_CHAT_ID as the target for any proactive replies.
SCHEDULE_INTERVAL_SECONDS=
# IANA timezone name (e.g. Europe/London) used when formatting timestamps
# shown to the agent. Defaults to UTC.
TIMEZONE=Europe/London
# Self-improvement (optional — leave SELF_REPO_DIR unset to disable). When
# set, the bot clones its own repo to SELF_REPO_DIR on startup and the agent
# is told how to edit, push and redeploy itself. Requires GITHUB_TOKEN (repo
# push) and FLY_API_TOKEN (deploy).
SELF_REPO_DIR=
SELF_REPO_URL=
SELF_DEPLOY_CMD=
GITHUB_TOKEN=
FLY_API_TOKEN=
# Separate read-only finance connector (never paste these into Telegram)
FINANCE_CONNECTOR_SECRET=
TRADING212_API_KEY=
TRADING212_API_SECRET=
MONZO_OB_BASE_URL=
MONZO_OB_ACCESS_TOKEN=
AMEX_OB_BASE_URL=
AMEX_OB_ACCESS_TOKEN=
